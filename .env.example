# ============================================================
# REQUIRED - App will crash without these
# ============================================================

# Go to https://supabase.com -> Your Project -> Settings -> API
# Copy "Project URL"
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Go to https://supabase.com -> Your Project -> Settings -> API
# Copy "anon public" key (under Project API keys)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY


# ============================================================
# OPTIONAL - Has defaults, won't crash if missing
# ============================================================

# Backend API URL - defaults to http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX) - leave blank to disable
VITE_GA_MEASUREMENT_ID=

# Comma-separated list of super-user emails - leave blank if not needed
VITE_SUPER_USER=
